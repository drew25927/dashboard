# Supabase 프로젝트 설정(Project Settings → API)에서 복사
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role 키 — 절대 커밋하지 말 것, Vercel 환경변수로만 등록

# 관리자 로그인 비밀번호 (원하는 값으로 직접 설정)
ADMIN_PASSWORD=change-me

# 구글 드라이브 과제 폴더를 읽어 과제 제출 현황을 자동으로 확인하는 데 쓰는 Google Drive API 키 (읽기 전용)
GOOGLE_API_KEY=
# (선택) 과제 폴더 ID — 비워 두면 기본 "02_과제" 폴더를 사용
DRIVE_SUBMISSION_FOLDER_ID=
